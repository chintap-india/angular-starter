{
  "name": "chintap-angular-starter",
  "version": "1.5.0",
  "description": "Production-grade Angular 22 starter kit with out-of-the-box best practices for SEO, AEO, LLMO, GEO, and SSR/SSG.",
  "scripts": {
    "ng": "ng",
    "start": "NG_BUILD_SASS_EMBEDDED=false ng serve",
    "build": "NG_BUILD_SASS_EMBEDDED=false ng build && cp dist/chintap-angular-starter/browser/404/index.html dist/chintap-angular-starter/browser/404.html 2>/dev/null || true && mkdir -p dist/chintap-angular-starter/browser/.well-known && cp -r public/.well-known/* dist/chintap-angular-starter/browser/.well-known/ 2>/dev/null || true",
    "watch": "NG_BUILD_SASS_EMBEDDED=false ng build --watch --configuration development",
    "test": "NG_BUILD_SASS_EMBEDDED=false ng test",
    "test:run": "npx vitest run"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/chintap-india/angular-starter.git"
  },
  "homepage": "https://chintap-angular-starter.netlify.app",
  "bugs": {
    "url": "https://github.com/chintap-india/angular-starter/issues"
  },
  "author": {
    "name": "Chintap",
    "email": "hello@chintap.com",
    "url": "https://chintap.com"
  },
  "keywords": [
    "angular",
    "angular-22",
    "starter-kit",
    "seo",
    "aeo",
    "llmo",
    "geo",
    "ssg",
    "ssr",
    "signals",
    "tailwind-css",
    "material-design"
  ],
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.29",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
